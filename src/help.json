{
  "title": "9W9",
  "children": [
    {
      "title": "Overview",
      "lines": [
        "TR-909 style drum",
        "machine. Circuit-",
        "modelled kick,",
        "snare, toms, rim",
        "and clap; sampled",
        "hats and cymbals",
        "(like the real 909)."
      ]
    },
    {
      "title": "Playing",
      "lines": [
        "Pads (left 4x4):",
        " row1: BD SD LT MT",
        " row2: HT RS CP CH",
        " row3: OH CR RC MAIN",
        " row4: .. .. REV DLY",
        "",
        "Shift+Pad: select",
        " without sounding.",
        "Mute+Pad: mute that",
        " drum ([M] in bar).",
        "Main/Rev/Dly pads",
        " switch page only."
      ]
    },
    {
      "title": "Editing",
      "lines": [
        "Knobs 1-8 edit the",
        "visible page.",
        "Jog: change page.",
        "Jog click: section",
        "list (and Save etc",
        "on the last pages).",
        "All pots are 0-127.",
        "",
        "SHIFT + jog click",
        "on Main: locks the",
        "page. Pads still",
        "play, page stays.",
        "([L] in the bar)",
        "Shift+Pad still",
        "selects. Again to",
        "unlock."
      ]
    },
    {
      "title": "Velocity",
      "lines": [
        "Accent is the level",
        "a full-velocity hit",
        "reaches.",
        "",
        "Velocity is how far",
        "BELOW Accent a soft",
        "hit falls. It only",
        "carves down, never",
        "up.",
        "",
        "0: velocity ignored,",
        "everything plays",
        "straight at Accent."
      ]
    },
    {
      "title": "Send FX",
      "lines": [
        "Every drum but the",
        "kick has Rev and",
        "Dly sends on its",
        "page.",
        "",
        "Reverb and Delay",
        "pages are last.",
        "Delay Time is a",
        "note division,",
        "synced to tempo.",
        "HPF on each keeps",
        "low end out."
      ]
    },
    {
      "title": "Sequencing",
      "lines": [
        "Use Move's own",
        "sequencer: drum",
        "track with a kit,",
        "mute it (HiJack),",
        "set track MIDI OUT",
        "to the slot channel.",
        "Each drum = one",
        "lane. Note map:",
        "drum rack 36-46",
        "(or GM, switchable)."
      ]
    },
    {
      "title": "Remote UI",
      "lines": [
        "Full panel in the",
        "browser:",
        "move.local:7700",
        " /remote-ui",
        "Drag knobs, mute",
        "buttons per drum."
      ]
    }
  ]
}
