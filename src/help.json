{
  "title": "9W9",
  "children": [
    {
      "title": "Overview",
      "lines": [
        "TR-909 style drum",
        "machine. Circuit-",
        "modelled kick,",
        "snare, toms, rim",
        "and clap; sampled",
        "hats and cymbals",
        "(like the real 909)."
      ]
    },
    {
      "title": "Playing",
      "lines": [
        "Pads (left 4x4):",
        " row1: BD SD LT MT",
        " row2: HT RS CP CH",
        " row3: OH CR RC",
        " pad16: Master pg",
        "",
        "Shift+Pad: select",
        " without sounding.",
        "Mute+Pad: mute that",
        " drum ([M] in bar)."
      ]
    },
    {
      "title": "Editing",
      "lines": [
        "Knobs 1-8 edit the",
        "visible page.",
        "Jog: change page.",
        "All pots are 0-127.",
        "",
        "Kick: Pitch, P.Depth",
        "(sweep amount), Tune",
        "(sweep decay), Sub,",
        "Tube, Drift on the",
        "BD MORE page."
      ]
    },
    {
      "title": "Sequencing",
      "lines": [
        "Use Move's own",
        "sequencer: drum",
        "track with a kit,",
        "mute it (HiJack),",
        "set track MIDI OUT",
        "to the slot channel.",
        "Each drum = one",
        "lane. Note map:",
        "drum rack 36-46",
        "(or GM, switchable)."
      ]
    },
    {
      "title": "Remote UI",
      "lines": [
        "Full panel in the",
        "browser:",
        "move.local:7700",
        " /remote-ui",
        "Drag knobs, mute",
        "buttons per drum."
      ]
    }
  ]
}
